#!/usr/bin/env bash
# lock — close encrypted source and secrets volumes
# Usage:
#   lock              close both volumes
#   lock source       close source only
#   lock secrets      close secrets only
#
# See also: unlock

set -euo pipefail

# shellcheck source=../lib/syscheck.sh
source "$(dirname "$(readlink -f "$0")")/../lib/syscheck.sh"

ALL_VOLUMES=(source secrets)

# ── Helpers ────────────────────────────────────────────────────────────────────
is_mounted() { mountpoint -q "/mnt/$1" 2>/dev/null; }

print_status() {
  echo -e "\n${BOLD}${CYAN}Volume status${RESET}"
  for v in "${ALL_VOLUMES[@]}"; do
    if is_mounted "$v"; then
      echo -e "  ${DIM}○${RESET}  $v  still open → /mnt/$v"
    else
      echo -e "  ${GREEN}✓${RESET}  $v  closed"
    fi
  done
  echo ""
}

close_volume() {
  local name="$1"
  local mount="/mnt/${name}"

  if ! is_mounted "$name"; then
    ok "$name: already closed"
    return
  fi

  # Check for open files before unmounting
  local open_files
  open_files=$(sudo lsof +D "$mount" 2>/dev/null | tail -n +2 | wc -l || true)
  if [[ "$open_files" -gt 0 ]]; then
    warn "$name: $open_files open file(s) — close them first or data may be lost"
    sudo lsof +D "$mount" 2>/dev/null | tail -n +2 | awk '{print "    " $1 " (pid " $2 ") → " $NF}' | head -10
    return 1
  fi

  sudo umount "$mount"
  sudo cryptsetup luksClose "$name"
  ok "$name: closed"
}

# ── Parse args ─────────────────────────────────────────────────────────────────
TARGETS=()

for arg in "$@"; do
  case "$arg" in
    source|secrets) TARGETS+=("$arg") ;;
    *)              echo "Usage: lock [source|secrets]" >&2; exit 1 ;;
  esac
done

[[ ${#TARGETS[@]} -eq 0 ]] && TARGETS=("${ALL_VOLUMES[@]}")

# ── Close ──────────────────────────────────────────────────────────────────────
echo -e "\n${BOLD}${CYAN}Locking volumes${RESET}"

for v in "${TARGETS[@]}"; do
  close_volume "$v"
done

print_status
